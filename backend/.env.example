# Django 安全密钥，生产环境需更换为随机生成的复杂字符串
SECRET_KEY=your_secret_key_here
# 调试模式开关，生产环境应设置为 False
DEBUG=True
# 允许访问的主机列表，多个主机用逗号分隔
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库名称
DB_NAME=shop
# 数据库用户名
DB_USER=root
# 数据库密码，生产环境应使用强密码
DB_PASSWORD=123456
# 数据库主机地址
DB_HOST=localhost
# 数据库端口号，MySQL 默认为 3306
DB_PORT=3306

# Redis 缓存服务器主机地址
REDIS_HOST=localhost
# Redis 服务端口号，默认为 6379
REDIS_PORT=6379
# Redis 访问密码，如无密码则留空
REDIS_PASSWORD=

# JWT 令牌签名密钥，生产环境需使用随机生成的安全密钥
JWT_SECRET_KEY=your_jwt_secret_key_here